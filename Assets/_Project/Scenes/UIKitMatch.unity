  m_Script: {fileID: 11500000, guid: 46d6c5089874c59469e7557d23eb6df7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: MafiaNight.UI.Kit::MafiaNight.UI.Kit.ArabicText
  text: "\u0627\u062A\u0641\u0642 \u0645\u0639 \u0634\u0631\u0643\u0627\u0626\u0643.
    \u0627\u0644\u0636\u062D\u064A\u0629 \u0627\u0644\u0644\u064A \u0639\u0644\u064A\u0647\u0627
    \u0623\u0643\u062B\u0631 \u0623\u0635\u0648\u0627\u062A \u062A\u0646\u0642\u062A\u0644.
    \u0635\u0648\u062A\u0643 \u0645\u0633\u0645\u0648\u0639 \u0644\u0644\u0645\u0627\u0641\u064A\u0627
    \u0641\u0642\u0637."
  wrap: 1
  arabicDigits: 0
--- !u!114 &1971406889
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
