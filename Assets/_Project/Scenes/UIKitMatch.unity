  text: "\u062A\u0642\u062F\u0631 \u062A\u063A\u064A\u0651\u0631 \u0635\u0648\u062A\u0643
    \u0644\u062D\u062F \u0645\u0627 \u064A\u0646\u062A\u0647\u064A \u0627\u0644\u0648\u0642\u062A.
    \u0627\u0644\u062A\u0639\u0627\u062F\u0644 = \u0645\u0627 \u062D\u062F\u0627
    \u0628\u064A\u0637\u0644\u0639."
  wrap: 0
  arabicDigits: 0
