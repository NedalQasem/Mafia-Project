  m_Name: 
  m_EditorClassIdentifier: MafiaNight.UI.Kit::MafiaNight.UI.Kit.ArabicText
  text: "\u062A\u0634\u0648\u0641 \u0627\u0644\u0637\u0627\u0648\u0644\u0629 \u0648\u0627\u0644\u0645\u0648\u062A\u0649
    \u0648\u0627\u0644\u062A\u0635\u0648\u064A\u062A\u060C \u0648\u062A\u0633\u0645\u0639
    \u0646\u0642\u0627\u0634 \u0627\u0644\u0646\u0647\u0627\u0631. \u0627\u0644\u0623\u062F\u0648\u0627\u0631
    \u0648\u0643\u0644\u0627\u0645 \u0627\u0644\u0644\u064A\u0644 \u0645\u062E\u0641\u064A\u0629
    \u0639\u0646\u0643. \u0628\u0627\u0644\u0645\u0628\u0627\u0631\u0627\u0629 \u0627\u0644\u0642\u0627\u062F\u0645\u0629
    \u062A\u062F\u062E\u0644 \u062A\u0644\u0642\u0627\u0626\u064A\u0627\u064B."
  wrap: 1
  arabicDigits: 0
