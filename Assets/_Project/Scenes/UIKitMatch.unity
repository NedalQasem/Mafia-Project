  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0639\uFEEE\uFEE4\uFEB4\uFEE3 \uFEDA\uFE97\uFEEE\uFEBB .\uFEDE\uFE98\uFED8\uFEE8\uFE97
