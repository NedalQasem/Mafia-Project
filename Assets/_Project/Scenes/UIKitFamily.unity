    \u0628\u0639\u0636 \u0644\u0644\u063A\u0631\u0641 \u0648\u062A\u0634\u0648\u0641\u0648\u0627
    \u0645\u064A\u0646 \u0628\u063A\u0631\u0641\u0629."
