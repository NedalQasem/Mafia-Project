  text: "\u0644\u0645\u0627 \u062A\u0642\u0628\u0644 \u0627\u0644\u0637\u0644\u0628
    \u0628\u062A\u0635\u064A\u0631\u0648\u0627 \u0623\u0635\u062F\u0642\u0627\u0621
