  m_EditorClassIdentifier: MafiaNight.UI.Kit::MafiaNight.UI.Kit.ArabicText
  text: "\u0636\u064A\u0641 \u0623\u0635\u062F\u0642\u0627\u0621 \u0628\u0631\u0642\u0645
    \u0627\u0644\u0647\u0648\u064A\u0629\u060C \u0623\u0648 \u062A\u0639\u0631\u0651\u0641
    \u0639\u0644\u0649 \u0627\u0644\u0646\u0627\u0633 \u0628\u0627\u0644\u0633\u0627\u062D\u0629
    \u0627\u0644\u0639\u0627\u0645\u0629 \u0648\u0628\u0627\u0644\u0633\u0647\u0631\u0627\u062A.
    \u0644\u0645\u0627 \u062A\u062D\u0643\u064A \u0645\u0639 \u062D\u062F\u0627 \u0628\u062A\u0637\u0644\u0639
    \u0645\u062D\u0627\u062F\u062B\u062A\u0647 \u0647\u0648\u0646."
